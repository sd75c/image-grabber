{
  "manifest_version": 3,
  "name": "图提取 ImageGrab",
  "version": "1.0.0",
  "description": "在淘宝、天猫、京东、拼多多商品页一键提取商品图片，筛选后批量下载，并尽可能转换为 PNG。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "downloads"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "图提取：扫描当前商品页图片",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.tmall.hk/*",
        "https://*.jd.com/*",
        "https://*.jd.hk/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
